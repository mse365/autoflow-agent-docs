          "id": "8077F94D-B9C6-48AC-A4AA-CD709EDFC0ED",
          "value": "true",
          "description": "Yes",
          "steps": [
            {
              "id": "98F79856-BB74-40F0-91EB-C5AB5535F798",
              "type": "action",
              "action": 5564406,
              "description": "Stock on the sales line",
              "slug": "StockSales",
              "iconUrl": "https://statics.autoflow.mse365.de/icons/database-edit.svg",
              "terminating": false,
              "configuration": {
                "reference": "{{trigger_SalesLine}}",
                "tableNo": 37,
                "triggers": true,
                "values": [
                  {
                    "lineNo": 10000,
                    "fieldNo": 5564013,
                    "value": "{{Price_stock}}",
                    "validate": true,
                    "inputFormat": "9"
                  },
                  {
                    "lineNo": 20000,
                    "fieldNo": 5564015,
                    "value": "{{currentDateTime;9}}",
                    "validate": true,
                    "inputFormat": "9"
                  }
                ]
              },
              "outputs": [
                {
                  "name": "rec",
                  "type": "reference",
                  "tableNo": 37
                }
              ]
            }
          ]
        },
        {
          "id": "CAA7D48B-95A8-464E-B035-B81527317413",
          "value": "false",
